# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.

# The public host name. Also the Frappe site name.
SITE_NAME=support.runonflux.io

# Long random strings. The admin password is for the "Administrator" login.
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=

# Upstream Helpdesk release this image is built on. See docs/upgrade.md.
HELPDESK_VERSION=v1.30.2

# Image name and tag for the built image (or a registry image to pull).
IMAGE=flux-helpdesk
TAG=local

# Where nginx listens. Keep 127.0.0.1 behind a reverse proxy that terminates TLS.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# 1 = never send email (staging, imports). 0 = normal.
MUTE_EMAILS=1

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
